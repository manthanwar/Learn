		"explorer.sortOrder": "type",
		"files.associations": {
			".code-snippets": "json",
			"*.awk": "sh",
			"*.clang-format": "yaml",
			"*.cpp": "cpp",
			"*.fd": "latex",
			"*.hbs": "html",
			"*.jsx": "javascript",
			"*.md.html": "markdown",
			"*.sty": "tex",
			"*.thor": "ruby",
			"*.xml": "html",
			"Jenkinsfile*": "groovy",
			"numeric": "cpp"
		},
		"html.format.enable": true,
		"json.format.keepLines": true,
		"latex-workshop.latex.bibDirs": [],
		"latex-workshop.bibtex-format.align-equal.enabled": true,
		"latex-workshop.intellisense.package.enabled": true,
		"latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
		"latex-workshop.synctex.afterBuild.enabled": true,
		"latex-workshop.showContextMenu": true,
		"latex-workshop.view.pdf.viewer": "tab",
		"latex-workshop.latex.watch.pdf.delay": 250,
		"latex-workshop.view.pdf.external.viewer.command": "SumatraPDF",
		"latex-workshop.view.pdf.external.viewer.args": [
			"-forward-search",
			"%TEX%",
			"%LINE%",
			"-reuse-instance",
			"-inverse-search",
			"\"cmd.exe\" /c code -r -g \"%f\":\"%l\"",
			"%PDF%"
