    // "latex-workshop.view.pdf.external.viewer.args": [
    //     "--unique",
    //     "%PDF%"
    // ],
    // "latex-workshop.view.pdf.external.synctex.command": "C:/Users/amit/AppData/Local/SumatraPDF/SumatraPDF.exe",
    // "latex-workshop.view.pdf.external.synctex.args": [
    //     "-forward-search",
    //     "%TEX%",
    //     "%LINE%",
    //     "-reuse-instance",
    //     "-inverse-search",
    //     "\"C:\\Users\\amit\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe\" -r -g \"%f:%l\"",
    //     "%PDF%"
    // ],


    // "\"C:/Users/amit/AppData/Local/Programs/Microsoft VS Code/Code.exe\" \"C:/Users/amit/AppData/Local/Programs/Microsoft VS Code/resources/app/out/cli.js\" -r -g \"%f\":\"%l\"",


    "latex-workshop.latex.tools": [
        {
            "name": "latex",
            "command": "latex",
            "args": [
                "-time-statistics",
                "-halt-on-error",
                "-file-line-error",
                // "-output-directory=TeXAux",
                "-aux-directory=TeXAux",
                "-synctex=-1",
                "%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ],
            "env": { }
        },
        {
            "name": "dvips",
            "command": "dvips",
            "args": [
                "-q",
                "%DOCFILE%.dvi",
                "-o",
                "%DOCFILE%.ps"
            ]
        },
        {
            "name": "ps2pdf",
            "command": "ps2pdf",
            "args": [
                "-dNOSAFER",
                "%DOCFILE%.ps",
                "%DOCFILE%.pdf"
            ]
        },
        {
            "name": "clean",
            "command": "latexmk",
            "args": [
                "-C"
            ]
        },
        {
            "name": "auxdel",
            "command": "make",
            "args": [
                "clean"
            ]
        },
        {
            "name": "auxrm",
            "command": "rm",
            "args": [
                "-r",
                "-f",
                "TeXAux"
            ]
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-auxdir=TeXAux",
                "-bibtex-cond1",
                "-dvi",
                "ps",
                "-pdfps",
                "-view=pdf",
                "-pvc",
                "-quiet",
                "-synctex=-1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": { }
        },
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": { }
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": { }
        },
        {
            "name": "latexmk_rconly",
            "command": "latexmk",
            "args": [
                "%DOC%"
            ],
            "env": { }
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ],
            "env": { }
        },
        {
            "name": "rnw2tex",
            "command": "Rscript",
            "args": [
                "-e",
                "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOCFILE_EXT%')"
            ],
            "env": { }
        },
        {
            "name": "jnw2tex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"tex\")"
            ],
            "env": { }
        },
        {
            "name": "jnw2texmintex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"texminted\")"
            ],
            "env": { }
        },
        {
            "name": "tectonic",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "%DOC%.tex"
            ],
            "env": { }
        }

    ],
