{
    "security.workspace.trust.untrustedFiles": "open",

    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Dracula",
    "workbench.statusBar.visible": true,
    "workbench.colorCustomizations": {
        // "editor.background": "#333"
    },

    "editor.tokenColorCustomizations": {
        "comments": "#baa",
    },

    "editor.tabSize": 4,
    "editor.indentSize": 4,
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.fontFamily": "Fira Code, Source Code Pro, Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontWeight": "300",
    "editor.fontSize": 15,
    // "editor.lineHeight": 20,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,

    "editor.formatOnSaveMode": "modifications",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,

    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true
    },
    "eslint.validate": [
        "javascript"
    ],

    // "files.autoSave": "afterDelay",
    "files.eol": "\n",
    "files.associations": {
        "*.cpp": "cpp"
    },

    "terminal.integrated.defaultProfile.windows": "Git Bash",

    // "terminal.integrated.fontFamily": "Menlo for Powerline",
    "terminal.integrated.fontFamily": "Fira Code, Source Code Pro, Consolas, monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontWeight": "300",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.copyOnSelection": true,

    // "terminal.integrated.fontFamily": "Inconsolata for Powerline",

    // "terminal.integrated.fontFamily": "MesloLGM Nerd Font",

    // "terminal.integrated.fontFamily": "DejaVu Sans Mono for Powerline",



    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    "html.format.wrapAttributes": "force-aligned",
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "html.format.enable": true,
    "[html]": {
        "editor.suggest.insertMode": "replace",
        "editor.formatOnType": true,
    },

    "[javascript]": {
        "editor.tabSize": 2
    },

    "json.format.keepLines": true,

    "[json]": {
        "editor.tabSize": 2,
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },


    "[latex]": {
        "editor.lineNumbers": "off",
        "editor.minimap.enabled": false,
        "editor.quickSuggestions": {
            "other": "off",
            "comments": "off",
            "strings": "off"
        }
    },


    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoBuild.interval": 3000,
    "latex-workshop.latex.autoClean.run": "onFailed",
    "latex-workshop.latex.recipe.default": "latex-dvips-ps2pdf",


    "latex-workshop.intellisense.biblatexJSON.replace": { },
    "latex-workshop.intellisense.package.enabled": true,
    // "latex-workshop.view.pdf.ref.viewer": "external",
    //  "latex-workshop.view.pdf.zoom": "page-fit",
    // "latex-workshop.message.warning.show": false,
    // "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.showContextMenu": true,
    "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
    // "latex-workshop.view.pdf.viewer": "external",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.watch.pdf.delay": 250,
    "latex-workshop.view.pdf.external.viewer.command": "SumatraPDF",
    "latex-workshop.view.pdf.external.viewer.args": [
        "-forward-search",
        "%TEX%",
        "%LINE%",
        "-reuse-instance",
        "-inverse-search",
        "\"cmd.exe\" /c code -r -g \"%f\":\"%l\"",
        "%PDF%"
    ],
    "latex-workshop.view.pdf.external.synctex.command": "SumatraPDF",
    "latex-workshop.view.pdf.external.synctex.args": [
        "-forward-search",
        "%TEX%",
        "%LINE%",
        "-reuse-instance",
        "-inverse-search",
        "\"cmd.exe\" /c code -r -g \"%f\":\"%l\"",
        "%PDF%"
    ],

    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.synctex.synctexjs.enabled": true,

    // "latex-workshop.view.pdf.color.light.pageColorsForeground":"#336699",
    // "latex-workshop.view.pdf.color.light.backgroundColor":"#33996",


    // "latex-workshop.view.pdf.viewer": "external",
